# Zelfde chat-API als Ask Maarten op je portfolio (OpenAI-compatibel, bv. Groq)
ASK_API_URL=https://api.groq.com/openai/v1/chat/completions
ASK_API_KEY=
ASK_MODEL=openai/gpt-oss-120b

# Ondertekent de voortgangs-cookie. Lange willekeurige string, bv. `openssl rand -hex 32`.
# Ontbreekt hij, dan valt de app terug op ASK_API_KEY als sleutel.
SESSION_SECRET=

# Optioneel: Upstash Redis voor de rate limits (gedeeld over alle servers).
# Zonder (of als Upstash onbereikbaar is) tellen de limieten per serverinstantie in het geheugen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Waar de "Let's meet"-knop naartoe mailt
NEXT_PUBLIC_CONTACT_EMAIL=
